.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(125, 211, 252, 0.28), transparent 28%),
    linear-gradient(180deg, #eff6ff 0%, #f8fbff 48%, #eef2ff 100%);
}

.study-shell {
  min-height: calc(100vh - 48rpx);
  display: flex;
  flex-direction: column;
}

.topbar,
.topbar-left,
.action-row,
.study-footer,
.detail-header,
.detail-actions,
.drawer-head,
.item-main,
.item-side {
  display: flex;
  align-items: center;
}

.topbar,
.study-footer,
.detail-header,
.detail-actions,
.drawer-head,
.item-main,
.item-side {
  justify-content: space-between;
}

.topbar {
  gap: 20rpx;
  justify-content: space-between;
  padding: 8rpx 2rpx 0;
}

.topbar-left {
  gap: 16rpx;
}

.topbar-right {
  margin-left: auto;
  display: flex;
  justify-content: flex-end;
}

.drawer-trigger,
.ghost-btn,
.primary-btn,
.rating-btn,
.close-btn,
.stage-badge,
.result-badge,
.drawer-tab,
.filter-chip {
  border-radius: 999rpx;
}

.drawer-trigger,
.ghost-btn,
.close-btn {
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
}

.drawer-trigger,
.ghost-btn,
.primary-btn,
.close-btn,
.filter-chip,
.drawer-tab {
  font-size: 24rpx;
}

.drawer-trigger,
.ghost-btn,
.close-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2563eb 0%, #38bdf8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 26rpx rgba(37, 99, 235, 0.24);
}

.brand-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    -14rpx -12rpx 0 -2rpx rgba(255,255,255,0.9),
    14rpx 0 0 -3rpx rgba(255,255,255,0.75),
    -8rpx 14rpx 0 -4rpx rgba(255,255,255,0.65);
}

.progress-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.topbar-copy .progress-main {
  font-size: 38rpx;
}

.progress-main {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.progress-sub {
  color: #64748b;
  font-size: 22rpx;
}

.drawer-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  line-height: normal;
  min-width: 144rpx;
  justify-content: center;
  margin-left: auto;
}

.menu-icon {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #2563eb;
}

.menu-line.short {
  width: 16rpx;
}

.menu-text {
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
}

.book-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 24rpx 24rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(239,246,255,0.98) 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.14);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 36rpx rgba(37, 99, 235, 0.08);
}

.download-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(135deg, rgba(219, 234, 254, 0.96) 0%, rgba(255, 255, 255, 0.94) 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.14);
  border-radius: 22rpx;
  box-shadow: 0 16rpx 34rpx rgba(37, 99, 235, 0.08);
}

.download-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.download-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.download-value {
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
}

.download-track {
  margin-top: 14rpx;
}

.download-desc {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.book-label {
  display: block;
  color: #64748b;
  font-size: 22rpx;
}

.book-value {
  display: block;
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 700;
}

.book-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #2563eb;
}

.book-action-text,
.book-arrow {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.book-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.daily-overview-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(37, 99, 235, 0.12);
  box-shadow: 0 16rpx 34rpx rgba(37, 99, 235, 0.08);
}

.daily-goal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.daily-kicker,
.daily-title,
.daily-badge,
.daily-goal-value,
.daily-goal-label,
.daily-reward {
  display: block;
}

.daily-kicker {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
}

.daily-title {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
}

.daily-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.daily-goal-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.compact-grid {
  gap: 10rpx;
}

.daily-goal-item {
  padding: 14rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(248, 250, 252, 0.92);
  text-align: center;
}

.daily-goal-value {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
}

.daily-goal-label {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 20rpx;
}

.daily-reward {
  margin-top: 14rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.5;
}

.overview-progress {
  margin-top: 16rpx;
}

.overview-progress .compact {
  margin: 0;
}

.overview-progress-text {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  margin-top: 18rpx;
  background: rgba(191, 219, 254, 0.9);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-track.compact {
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #38bdf8 0%, #2563eb 100%);
  border-radius: 999rpx;
}

.card-stage {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 20rpx;
}

.card-stack {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  border-radius: 34rpx;
}

.back-shadow {
  top: 120rpx;
  bottom: 188rpx;
  background: rgba(37, 99, 235, 0.08);
  transform: rotate(-3deg);
}

.mid-shadow {
  top: 104rpx;
  bottom: 204rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  transform: rotate(2deg);
}

.flip-scene {
  position: relative;
  height: 780rpx;
  perspective: 1600rpx;
}

.flash-overlay {
  position: absolute;
  inset: 18rpx;
  border-radius: 34rpx;
  opacity: 0;
  pointer-events: none;
}

.flash-again {
  animation: flashAgain 0.5s ease;
}

.flash-hard {
  animation: flashHard 0.5s ease;
}

.flash-good {
  animation: flashGood 0.5s ease;
}

.word-card {
  position: absolute;
  inset: 0;
  transform-style: preserve-3d;
  transition: transform 0.65s cubic-bezier(0.22, 0.9, 0.32, 1);
}

.word-card.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  inset: 0;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.93);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 26rpx 60rpx rgba(15, 23, 42, 0.08);
  backface-visibility: hidden;
}

.card-front {
  display: flex;
  flex-direction: column;
}

.card-back {
  transform: rotateY(180deg);
  display: flex;
  flex-direction: column;
}

.face-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stage-badge-wrap {
  min-width: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stage-badge,
.result-badge {
  min-width: 104rpx;
  height: 52rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.stage-badge text,
.result-badge text {
  display: block;
  line-height: 1;
}

.stage-new {
  background: #dcfce7;
  color: #166534;
}

.stage-review {
  background: #dbeafe;
  color: #1d4ed8;
}

.result-again {
  background: #fee2e2;
  color: #b91c1c;
}

.result-hard {
  background: #fef3c7;
  color: #92400e;
}

.result-good {
  background: #dbeafe;
  color: #1d4ed8;
}

.stage-mini {
  color: #64748b;
  font-size: 22rpx;
}

.card-meter {
  min-width: 132rpx;
  padding: 10rpx 14rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.meter-label {
  color: #64748b;
  font-size: 18rpx;
  line-height: 1.2;
}

.meter-value {
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.front-core {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.front-word {
  color: #0f172a;
  font-size: 88rpx;
  line-height: 1.15;
  font-weight: 700;
  text-align: center;
}

.front-word-row {
  align-items: center;
  justify-content: center;
}

.front-kana,
.back-kana,
.detail-kana {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 32rpx;
}

.front-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
}

.front-tip {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.back-content {
  flex: 1;
  overflow: hidden;
  margin-top: 18rpx;
}

.word-line {
  text-align: center;
}

.back-word-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 56rpx;
}

.back-word-main {
  justify-content: center;
}

.favorite-inline {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-word,
.detail-word {
  display: block;
  color: #0f172a;
  font-size: 54rpx;
  font-weight: 700;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.meta-row.compact {
  margin-top: 14rpx;
}

.meta-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  font-size: 22rpx;
}

.meaning-card,
.example-card,
.word-list-item,
.stat-card,
.settings-panel,
.library-panel,
.empty-panel,
.detail-panel {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
}

.meaning-card,
.example-card {
  padding: 22rpx;
  margin-top: 20rpx;
}

.meaning-card.compact,
.example-card.compact {
  margin-top: 14rpx;
  padding: 18rpx;
}

.meaning-label,
.stat-label {
  display: block;
  color: #64748b;
  font-size: 22rpx;
}

.meaning-value {
  display: block;
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.7;
}

.example-jp,
.example-furi {
  display: block;
  color: #0f172a;
  line-height: 1.8;
}

.example-zh {
  display: block;
  margin-top: 12rpx;
  color: #475569;
  line-height: 1.7;
}

.line-with-icon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.inline-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.inline-icon.large {
  width: 46rpx;
  height: 46rpx;
}

.back-toolbar {
  display: none;
}

.toolbar-item {
  flex: 1;
  min-height: 84rpx;
  padding: 0 18rpx;
  background: linear-gradient(135deg, rgba(239,246,255,0.96) 0%, rgba(219,234,254,0.96) 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.12);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.toolbar-label {
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.favorite-item {
  background: linear-gradient(135deg, rgba(255,251,235,0.96) 0%, rgba(254,243,199,0.96) 100%);
  border-color: rgba(217, 119, 6, 0.16);
}

.action-row {
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-row.major {
  margin-top: 30rpx;
}

.rating-btn,
.primary-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
}

.rating-btn.again {
  background: #fee2e2;
  color: #b91c1c;
}

.rating-btn.hard {
  background: #fef3c7;
  color: #92400e;
}

.rating-btn.good {
  background: #dbeafe;
  color: #1d4ed8;
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #fff;
}

.study-footer.pinned {
  gap: 16rpx;
  margin-top: 18rpx;
}

.ghost-btn.small {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
}

.ghost-btn.wide {
  width: 100%;
  margin-top: 12rpx;
}

.drawer-mask,
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.34);
  z-index: 20;
}

.drawer-panel {
  position: absolute;
  right: 0;
  top: 0;
  width: 78vw;
  height: 100vh;
  padding: 28rpx 22rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fbfdff 0%, #f8fbff 100%);
  box-shadow: -20rpx 0 50rpx rgba(15, 23, 42, 0.14);
  animation: drawerIn 0.24s ease;
}

.drawer-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.drawer-head .close-btn {
  margin-left: auto;
}

.drawer-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.drawer-tab {
  padding: 12rpx 20rpx;
  background: #eff6ff;
  color: #475569;
}

.drawer-tab.active {
  background: #2563eb;
  color: #fff;
}

.drawer-scroll {
  height: calc(100vh - 180rpx);
  margin-top: 18rpx;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.stats-grid {
  display: grid;
  gap: 14rpx;
}

.stats-grid.single-column {
  grid-template-columns: 1fr;
  margin-bottom: 18rpx;
}

.stat-card {
  padding: 22rpx;
}

.stat-value {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 700;
}

.stat-sub {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.settings-panel.inline-panel,
.library-panel.inline-panel {
  padding: 0;
  background: transparent;
  border: none;
}

.settings-row + .settings-row {
  margin-top: 16rpx;
}

.settings-label,
.settings-value {
  display: block;
  color: #475569;
  font-size: 24rpx;
}

.settings-value {
  text-align: right;
  color: #0f172a;
  font-weight: 700;
}

.search-input {
  width: 100%;
  height: 78rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 22rpx;
  border: 1rpx solid #dbeafe;
  font-size: 24rpx;
  line-height: 78rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  margin-bottom: 14rpx;
}

.filter-chip {
  padding: 12rpx 18rpx;
  background: #eff6ff;
  color: #475569;
}

.filter-chip.active {
  background: #2563eb;
  color: #fff;
}

.word-list-item {
  margin-bottom: 14rpx;
  padding: 18rpx;
}

.loading-tip {
  padding: 22rpx 0 6rpx;
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
}

.item-word {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.item-kana,
.item-prof,
.item-stage,
.empty-desc {
  color: #64748b;
  font-size: 22rpx;
}

.item-meaning {
  display: block;
  margin-top: 12rpx;
  color: #475569;
  line-height: 1.6;
}

.empty-panel {
  padding: 30rpx 24rpx;
  margin-top: 20rpx;
  text-align: center;
}

.empty-panel.compact {
  padding: 26rpx 20rpx;
}

.empty-title {
  display: block;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  line-height: 1.7;
}

.detail-mask {
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

.detail-panel {
  width: 100%;
  max-height: 82vh;
  padding: 28rpx;
  box-sizing: border-box;
  overflow: auto;
  animation: panelRise 0.22s ease;
}

@keyframes drawerIn {
  from {
    transform: translateX(100%);
    opacity: 0.6;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@keyframes panelRise {
  from {
    transform: translateY(24rpx);
    opacity: 0.72;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes flashAgain {
  0% { opacity: 0.58; background: rgba(239, 68, 68, 0.2); }
  100% { opacity: 0; background: rgba(239, 68, 68, 0); }
}

@keyframes flashHard {
  0% { opacity: 0.58; background: rgba(245, 158, 11, 0.18); }
  100% { opacity: 0; background: rgba(245, 158, 11, 0); }
}

@keyframes flashGood {
  0% { opacity: 0.58; background: rgba(59, 130, 246, 0.18); }
  100% { opacity: 0; background: rgba(59, 130, 246, 0); }
}
