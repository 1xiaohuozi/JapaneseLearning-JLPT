.leaderboard-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.24), transparent 28%),
    linear-gradient(180deg, #eef5ff 0%, #f7fbff 42%, #f4f7fb 100%);
}

.hero-panel,
.my-panel,
.top-card,
.rank-row,
.empty-panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.07);
}

.hero-panel {
  padding: 30rpx 28rpx;
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.96) 0%, rgba(56, 189, 248, 0.9) 100%);
}

.hero-kicker,
.hero-title,
.hero-desc {
  display: block;
  color: #fff;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  opacity: 0.84;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.my-panel {
  margin-top: 18rpx;
  padding: 24rpx;
}

.my-panel-top,
.rank-head,
.score-grid,
.top-tags,
.rank-meta {
  display: flex;
  align-items: center;
}

.my-panel-top,
.rank-head {
  justify-content: space-between;
}

.panel-label {
  display: block;
  color: #64748b;
  font-size: 22rpx;
}

.my-rank-text {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.my-total-score {
  min-width: 120rpx;
  height: 60rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1d4ed8 0%, #38bdf8 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.score-grid {
  gap: 14rpx;
  margin-top: 18rpx;
}

.score-card {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  text-align: center;
}

.score-name,
.tag {
  color: #64748b;
  font-size: 20rpx;
}

.score-value {
  display: block;
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.section {
  margin-top: 22rpx;
}

.section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.top-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.top-card {
  padding: 22rpx 16rpx;
  text-align: center;
}

.top-card.rank-1 {
  background: linear-gradient(180deg, rgba(255, 248, 220, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
}

.top-card.rank-2 {
  background: linear-gradient(180deg, rgba(241, 245, 249, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
}

.top-card.rank-3 {
  background: linear-gradient(180deg, rgba(255, 237, 213, 0.98) 0%, rgba(255, 255, 255, 0.95) 100%);
}

.top-card.self,
.rank-row.self {
  border-color: rgba(37, 99, 235, 0.28);
  box-shadow: 0 18rpx 42rpx rgba(37, 99, 235, 0.12);
}

.top-rank,
.top-badge,
.top-name,
.top-score {
  display: block;
}

.top-rank {
  color: #1d4ed8;
  font-size: 34rpx;
  font-weight: 700;
}

.top-badge {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 20rpx;
}

.top-name {
  margin-top: 16rpx;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.top-score {
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 700;
}

.top-tags,
.rank-meta {
  gap: 12rpx;
  flex-wrap: wrap;
}

.top-tags {
  justify-content: center;
  margin-top: 12rpx;
}

.tag,
.rank-meta text {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #475569;
}

.rank-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx;
  margin-top: 12rpx;
}

.rank-index {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
  color: #1d4ed8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-name {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
}

.rank-score {
  color: #1d4ed8;
  font-size: 32rpx;
  font-weight: 700;
}

.rank-meta {
  margin-top: 12rpx;
}

.empty-panel {
  margin-top: 28rpx;
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}
