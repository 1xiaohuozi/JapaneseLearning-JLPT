.memory-page {
  padding: 24rpx;
  background-color: #f9f9f9;
}

.memory-block {
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  padding: 0 24rpx 12rpx;
  overflow: hidden;
  transition: all 0.3s ease-in-out;
}

.memory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 12rpx;
  border-bottom: 1px solid #eee;
}

.memory-title {
  font-weight: 600;
  font-size: 32rpx;
  color: #333;
}

.toggle-icon {
  font-size: 28rpx;
  color: #888;
}

.memory-content {
  padding-top: 16rpx;
  padding-bottom: 12rpx;
}

.grammar-item {
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

/* 动画 */
.animated-fade-in {
  animation: fadeInUp 0.4s ease-in-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
