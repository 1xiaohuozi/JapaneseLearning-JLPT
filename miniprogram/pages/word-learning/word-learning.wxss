/* 容器背景 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  overflow: hidden;
  position: relative;
  padding: 40rpx 0;
}

.bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #a8edea, #fed6e3);
  z-index: -1;
}

/* 顶部 Tab 样式 */
.tab-container {
  width: 90%;
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 50rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  color: #555;
  transition: all 0.3s;
}

.tab-item.active {
  color: #3b82f6;
  border-bottom: 6rpx solid #3b82f6;
  font-weight: 700;
}

/* 进度条 */
.progress {
  margin-bottom: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  background: rgba(255,255,255,0.6);
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

/* 卡片容器固定高度 */
.card-wrapper {
  width: 80%;
  height: 500rpx;   /* 固定高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1500rpx;
  margin-bottom: 40rpx;
  position: relative;
}

/* 卡片固定尺寸（用于翻转） */
.card {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15);
  backface-visibility: hidden;
  position: absolute;
  top: 0;
  left: 0;
  padding: 0;
  transition: transform 0.8s ease-in-out;
  overflow: hidden;
}

/* 卡片滚动区 */
.card-scroll {
  width: 100%;
  height: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 正面滚动区：内容在卡片内垂直&水平居中 */
.front-scroll {
  display: flex;
  flex-direction: column;
}

/* 用一个容器把正面内容居中（且可滚动时不影响） */
.front-content {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 正反面翻转动画 */
.front { transform: rotateY(0deg); }
.back { transform: rotateY(180deg); }
.card-wrapper.flipped .front { transform: rotateY(-180deg); }
.card-wrapper.flipped .back { transform: rotateY(0deg); }

/* 单词与级别 */
.word { 
  display: block;
  width: 100%;
  font-size: 80rpx; 
  font-weight: bold; 
  color: #333; 
  text-align: center; 
  line-height: 1.3;
}
.level { 
  display: block;
  width: 100%;
  font-size: 32rpx; 
  color: #555; 
  margin-top: 16rpx; 
  text-align: center; 
}

/* 详细信息布局（背面） */
.detail-section { 
  width: 100%;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  width: 90rpx;
}

.content {
  font-size: 32rpx;
  color: #555;
  flex: 1;
  word-break: break-all;
}

/* 例句 */
.example-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
}

.example-block {
  display: flex;
  flex-direction: column;
}

.example-jp {
  font-size: 32rpx;
  color: #444;
  line-height: 40rpx;
}

.example-zh {
  font-size: 30rpx;
  color: #888;
  line-height: 38rpx;
  margin-left: 12rpx;
}

/* 按钮组（固定在卡片下方） */
.btn-group { 
  display: flex; 
  gap: 40rpx; 
  margin-top: 20rpx; 
  justify-content: center; 
}

/* 按钮通用样式 */
.btn { 
  width: 240rpx;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.3s ease-in-out;
}

/* 动画效果 */
.animate-btn { animation: pulse 1.5s infinite; }
.animate-btn:active { transform: scale(0.95); }

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* 按钮颜色 */
.btn-wrong { background: linear-gradient(135deg, #f7797d, #FBD786); color: #fff; }
.btn-right { background: linear-gradient(135deg, #56ab2f, #a8e063); color: #fff; }
.btn-next { background: linear-gradient(135deg, #36d1dc, #5b86e5); color: #fff; width: 300rpx; }
.btn-favorite { background: linear-gradient(135deg, #fcd34d, #fbbf24); color: #fff; }

/* 列表样式（收藏/全部） */
.list-item {
  width: 100%;              /* 撑满父容器 */
  max-width: 90%;           /* 控制实际显示宽度 */
  margin: 0 auto 24rpx auto;/* 自动左右居中 */
  background: rgba(255,255,255,0.7);
  padding: 24rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  color: #333;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
  text-align: center;
}


/* 熟练度勾勾（绝对定位在卡片右上） */
.card .proficiency-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 28rpx;
  color: green;
  z-index: 10;
}
.loading, .no-more {
  width: 90%;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 20rpx 0;
  margin: 10rpx auto;
  background: rgba(255,255,255,0.5);
  border-radius: 20rpx;
}
/* 公告提示 */
.announcement {
  width: 90%;
  margin: 20rpx auto 30rpx auto;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.8);
  border-left: 8rpx solid #3b82f6;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #444;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.announcement .link {
  color: #2563eb;
  font-weight: bold;
  text-decoration: underline;
}
