.score-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(251, 191, 36, 0.16), transparent 26%),
    radial-gradient(circle at top left, rgba(59, 130, 246, 0.14), transparent 30%),
    linear-gradient(180deg, #f8fbff 0%, #eef4ff 45%, #f8fafc 100%);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.hero-card,
.level-tabs,
.action-row,
.section-list,
.calc-btn {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.hero-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 52%, #38bdf8 100%);
  box-shadow: 0 22rpx 56rpx rgba(37, 99, 235, 0.18);
}

.hero-kicker,
.hero-title,
.hero-desc,
.badge-label,
.badge-value {
  display: block;
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.hero-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-badges {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.hero-badge {
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.badge-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.badge-value {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.level-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.level-chip {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(148, 163, 184, 0.12);
}

.level-chip.active {
  background: linear-gradient(135deg, #1d4ed8, #38bdf8);
  color: #ffffff;
}

.action-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.ghost-btn {
  min-width: 180rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 999rpx;
  border: none;
  background: #ffffff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(148, 163, 184, 0.12);
}

.section-list {
  margin-top: 20rpx;
}

.section-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 34rpx rgba(148, 163, 184, 0.12);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.section-title,
.section-subtitle,
.input-label,
.section-hint,
.result-kicker,
.result-title,
.result-date,
.final-score-label,
.final-score-value,
.final-score-status,
.result-section-title,
.result-grade,
.history-title,
.empty-history {
  display: block;
}

.section-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.score-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.input-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.input-card {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.input-label {
  color: #475569;
  font-size: 22rpx;
}

.score-input {
  margin-top: 12rpx;
  height: 78rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #0f172a;
  box-sizing: border-box;
}

.section-hint {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 22rpx;
}

.calc-btn {
  margin-top: 18rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  border: none;
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(249, 115, 22, 0.22);
}

.popup {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.5);
  z-index: 999;
  padding: 24rpx;
  box-sizing: border-box;
}

.popup-content {
  width: 100%;
  max-width: 680rpx;
  max-height: 82vh;
  overflow-y: auto;
  border-radius: 30rpx;
  background: #ffffff;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 22rpx 50rpx rgba(15, 23, 42, 0.22);
}

.result-header {
  text-align: center;
}

.result-kicker {
  color: #94a3b8;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.result-title {
  margin-top: 12rpx;
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 700;
}

.result-date {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.final-score-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  text-align: center;
}

.final-score-card.pass {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.final-score-card.fail {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
}

.final-score-label {
  color: #475569;
  font-size: 24rpx;
}

.final-score-value {
  margin-top: 12rpx;
  color: #0f172a;
  font-size: 46rpx;
  font-weight: 700;
}

.final-score-status {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.result-section-list {
  margin-top: 22rpx;
}

.result-section-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.result-section-head,
.result-row,
.popup-header-row,
.history-top,
.history-middle {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-section-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.result-grade {
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
}

.result-row {
  margin-top: 12rpx;
  color: #475569;
  font-size: 24rpx;
}

.result-note {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.7;
}

.close-btn {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  border: none;
  background: linear-gradient(135deg, #1d4ed8, #38bdf8);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.history-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.history-close {
  color: #64748b;
  font-size: 48rpx;
  line-height: 1;
}

.history-list {
  margin-top: 20rpx;
}

.history-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.history-level {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.history-date {
  color: #64748b;
  font-size: 22rpx;
}

.history-middle {
  margin-top: 14rpx;
}

.history-total {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 700;
}

.history-status {
  font-size: 24rpx;
  font-weight: 700;
}

.pass-text {
  color: #15803d;
}

.fail-text {
  color: #b91c1c;
}

.empty-history {
  margin-top: 28rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}
