<view class="container">   
  <!-- 顶部固定标题和切换 -->
  <view class="section-header">
    <view class="title-container">
      <text class="section-title" bindtap="toggleSectionDropdown">{{sectionTitle}}</text>
      <text class="dropdown-arrow">{{showDropdown ? '▲' : '▼'}}</text>
      <view class="title-decoration"></view>
  <!-- 进度条 -->
  <view class="listening-progress-container">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{listeningProgressStr}}"></view>

    </view>
    <text class="progress-text">{{listeningProgress | toFixed(0)}}%</text>
  </view>
      <!-- 下拉菜单 -->
    <!-- 下拉菜单 -->
<scroll-view 
  wx:if="{{showDropdown}}" 
  class="dropdown-menu" 
  scroll-y 
  scroll-into-view="{{currentSectionId}}"
  scroll-with-animation
>
<block wx:for="{{sections}}" wx:key="_id" wx:for-item="item">
  <view id="section-{{item._id}}" class="dropdown-item {{item._id === sectionId ? 'active' : ''}}" 
        bindtap="selectSection" data-id="{{item._id}}">
    {{item.title}}
    <image wx:if="{{item.isLearned}}" src="/images/绿勾.png" class="learned-checkmark-img" />
    <text wx:if="{{item.playCount > 0}}" class="play-count">x{{item.playCount}}</text>
  </view>
</block>

</scroll-view>

    </view>

    <view class="nav-buttons">
      <button class="nav-btn prev-btn" bindtap="prevSection" hover-class="btn-hover" style="position: relative; left: -46rpx; top: -1rpx">
        ◀ 上一小节
      </button>
      <button class="nav-btn next-btn" bindtap="nextSection" hover-class="btn-hover" style="position: relative; left: -38rpx; top: 0rpx">
        下一小节 ▶
      </button>
      <!-- <button class="nav-btn fix-btn" bindtap="fixOrder" hover-class="btn-hover" style="margin-left: 20rpx; background: #f43f5e; color: #fff;">
    修复排序
  </button> -->
    </view>
  </view>

  <!-- 对话展示 -->
  <scroll-view scroll-y="true" class="dialogue-list" scroll-with-animation>
    <block wx:for="{{dialogueList}}" wx:key="id">
      <view class="dialogue-card {{currentPlayingIndex === index ? 'playing' : ''}}">
        <view class="card-header">
          <view class="speaker-container">
            <view class="speaker-dot"></view>
            <text class="speaker">{{item.speaker}}：</text>
          </view>
          <!-- 已学习勾勾 -->
      
          <button class="translate-btn" bindtap="toggleTranslation" data-index="{{index}}" hover-class="btn-hover" style="position: relative; left: 249rpx; top: -4rpx">
            {{showTranslation[index] ? '隐藏翻译' : '翻译'}}
          </button>
        </view>

        <view class="text-content">
          <text class="text" selectable="true">{{item.text}}</text>
          <text class="kana" selectable="true">{{item.kana}}</text>
        </view>

        <view wx:if="{{showTranslation[index]}}" class="translation-container">
          <view class="translation-divider"></view>
          <text class="translation">{{item.translation}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{!dialogueList || dialogueList.length === 0}}" class="empty-state">
      <image src="/images/空空的.png" class="empty-image"></image>
      <text class="empty-text">暂无对话内容</text>
    </view>
  </scroll-view>

  <!-- 底部固定播放器 -->
<!-- 底部固定播放器 -->
<view class="audio-controls">
  <view class="player-top">
    <view class="audio-btn-wrapper" bindtap="togglePlay">
      <image 
        class="audio-btn-img {{isPlaying ? 'playing' : ''}}" 
        src="{{isPlaying ? '/images/pause.png' : '/images/play.png'}}" 
        mode="aspectFit"
      />
    </view>
  </view>
  <view class="player-bottom">
    <view class="time-display">
      <text class="time">{{currentTimeStr}}</text>
      <text class="time" style="width: 69rpx; display: block; box-sizing: border-box">{{durationStr}}</text>
    </view>
    <slider 
      min="0" 
      max="{{duration}}" 
      value="{{currentTime}}" 
      bindchange="onSliderChange"
      activeColor="#7c3aed"
      backgroundColor="#e2e8f0"
      block-color="#7c3aed"
      block-size="16"
      class="custom-slider"
    />
  </view>
</view>

</view>
<!-- 首次进入弹窗 -->
<view wx:if="{{showFirstTimeModal}}" class="modal-overlay">
  <view class="modal-box">
    <text class="modal-title">学习提示</text>
    <view class="modal-content-wrapper">
  <view class="modal-paragraph">
    <text>欢迎使用影子跟读练习！通过跟读和锻炼口语、听力可以更快提高日语水平。</text>
  </view>
  <view class="modal-paragraph">
    <text>本板块内容完全参照新版新シャドーイング 日本語を話そう 中~上級編，适合 N2~N1 水平的听力与口语锻炼。</text>
  </view>
  <view class="modal-paragraph">
    <text>每天坚持 10 分钟，反复练习，一个月就能看到立竿见影的效果。</text>
  </view>
  <view class="modal-paragraph notice">
    <text>注意：只有完整播放完音频才算增加学习次数哦</text>
  </view>
</view>

    <view class="modal-footer">
      <checkbox class="dont-show" bindchange="toggleDontShowAgain" checked="{{dontShowAgain}}">
        不再提示
      </checkbox>
      <button class="modal-btn" bindtap="closeFirstTimeModal">我知道了</button>
    </view>
  </view>
</view>