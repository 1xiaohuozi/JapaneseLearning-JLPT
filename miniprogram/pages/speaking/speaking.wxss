.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f7fafc 0%, #eef2ff 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.section-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  z-index: 100;
}

.title-container {
  position: relative;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(37, 99, 235, 0.08);
  backdrop-filter: blur(12rpx);
}

.title-row {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.dropdown-arrow {
  margin-left: 12rpx;
  color: #64748b;
  font-size: 22rpx;
}

.title-decoration {
  width: 96rpx;
  height: 6rpx;
  border-radius: 999rpx;
  margin-top: 10rpx;
  background: linear-gradient(90deg, #7c3aed, #2563eb);
}

.listening-goal-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5f3ff, #eff6ff);
  border: 1rpx solid rgba(124, 58, 237, 0.12);
}

.goal-kicker,
.goal-title,
.goal-reward {
  display: block;
}

.goal-kicker {
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-title {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
}

.goal-reward {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.listening-progress-container {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7c3aed, #2563eb);
  transition: width 0.25s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #334155;
  font-weight: 600;
}

.section-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.section-meta-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.dropdown-menu {
  margin-top: 18rpx;
  max-height: 480rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.active {
  background: #f5f3ff;
}

.dropdown-item-title {
  color: #1e293b;
  font-size: 26rpx;
}

.dropdown-item-side {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.learned-checkmark-img {
  width: 28rpx;
  height: 28rpx;
}

.play-count {
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 600;
}

.dialogue-list {
  flex: 1;
  margin-top: 360rpx;
  margin-bottom: 260rpx;
  padding: 8rpx 4rpx 0;
}

.dialogue-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.dialogue-card.playing {
  border-color: rgba(124, 58, 237, 0.25);
  box-shadow: 0 14rpx 32rpx rgba(124, 58, 237, 0.12);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.speaker-container {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.speaker-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7c3aed;
}

.speaker {
  font-size: 26rpx;
  font-weight: 700;
  color: #6d28d9;
}

.translate-btn {
  min-width: 124rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  margin-left: auto;
  flex-shrink: 0;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #7c3aed, #2563eb);
  color: #fff;
  font-size: 22rpx;
}

.text-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.text {
  font-size: 30rpx;
  line-height: 1.6;
  color: #0f172a;
  font-weight: 600;
}

.kana {
  font-size: 24rpx;
  color: #64748b;
}

.translation-container {
  margin-top: 18rpx;
}

.translation-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c4b5fd, transparent);
  margin-bottom: 14rpx;
}

.translation {
  display: block;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-image {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.45;
  margin-bottom: 24rpx;
}

.empty-text {
  color: #94a3b8;
  font-size: 24rpx;
}

.audio-controls {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -12rpx 36rpx rgba(15, 23, 42, 0.12);
}

.player-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin-bottom: 16rpx;
}

.section-switch-btn {
  min-width: 150rpx;
  height: 74rpx;
  line-height: 74rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.switch-icon {
  font-size: 20rpx;
  font-weight: 700;
}

.prev-inline {
  background: #f8fafc;
  color: #334155;
}

.next-inline {
  background: linear-gradient(135deg, #ede9fe, #dbeafe);
  color: #2563eb;
}

.audio-btn-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed, #2563eb);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(124, 58, 237, 0.3);
}

.audio-btn-wrapper:active {
  transform: scale(0.96);
}

.audio-btn-img {
  width: 62rpx;
  height: 62rpx;
}

.audio-btn-img.playing {
  animation: spin 3s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.player-bottom {
  display: flex;
  flex-direction: column;
}

.time-display {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.time {
  color: #475569;
  font-size: 22rpx;
}

.custom-slider {
  margin: 0;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.48);
  z-index: 999;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-box {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.18);
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #6d28d9;
  text-align: center;
}

.modal-content-wrapper {
  padding: 8rpx 0 12rpx;
}

.modal-paragraph {
  margin-bottom: 14rpx;
}

.modal-paragraph text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}

.modal-paragraph.notice text {
  color: #b91c1c;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dont-show-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dont-show-label {
  color: #64748b;
  font-size: 24rpx;
}

.modal-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  border: none;
  background: linear-gradient(135deg, #7c3aed, #2563eb);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
