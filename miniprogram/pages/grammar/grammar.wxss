.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.85), transparent 30%),
    linear-gradient(180deg, #edf4ff 0%, #f8fbff 55%, #ffffff 100%);
  color: #10213a;
}

.theme-summit {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #eff5ff 0%, #eef2ff 45%, #ffffff 100%);
}

.theme-ocean {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #eaf7ff 0%, #eef6ff 45%, #ffffff 100%);
}

.theme-forest {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #edf9f4 0%, #f4fbf7 45%, #ffffff 100%);
}

.theme-sunrise {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #fff3ea 0%, #fff8f1 45%, #ffffff 100%);
}

.hero-card,
.search-card,
.toolbar,
.grammar-card,
.empty-card,
.loading-card {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(16rpx);
}

.hero-card {
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ghost-btn,
.primary-btn,
.mode-btn,
.load-btn,
.save-btn,
.close-btn {
  border: none;
  border-radius: 22rpx;
  font-size: 24rpx;
  line-height: 1;
}

.ghost-btn {
  background: #eff6ff;
  color: #1d4ed8;
}

.primary-btn {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #fff;
}

.collection-strip {
  white-space: nowrap;
  margin-top: 28rpx;
}

.collection-row {
  display: inline-flex;
  gap: 14rpx;
}

.collection-pill {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}

.collection-pill.active {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(37, 99, 235, 0.24);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 26rpx;
}

.stat-card {
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.progress-panel {
  margin-top: 26rpx;
}

.progress-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-title,
.progress-text {
  font-size: 24rpx;
  color: #334155;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #60a5fa, #2563eb);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
}

.mode-toggle {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  background: #eef2ff;
  border-radius: 999rpx;
}

.mode-btn {
  min-width: 124rpx;
  background: transparent;
  color: #475569;
}

.mode-btn.active {
  background: #fff;
  color: #1d4ed8;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.18);
}

.meaning-switch {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #334155;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.clear-btn {
  min-width: 108rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: none;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
}

.grammar-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grammar-card {
  border-radius: 28rpx;
  padding: 24rpx;
}

.grammar-card-top {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.grammar-chip {
  min-width: 90rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0ecff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.grammar-meta {
  flex: 1;
}

.grammar-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #10213a;
  line-height: 1.35;
}

.grammar-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.grammar-meaning {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}

.grammar-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.empty-card,
.loading-card {
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  margin-top: 12rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.load-more {
  padding: 24rpx 0 36rpx;
}

.load-btn {
  width: 100%;
  background: #eff6ff;
  color: #1d4ed8;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  z-index: 20;
}

.modal-card {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.modal-index {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.modal-title {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.modal-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.favorite-icon {
  width: 46rpx;
  height: 46rpx;
}

.close-btn {
  padding: 14rpx 22rpx;
  background: #f1f5f9;
  color: #334155;
}

.detail-section {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.detail-text {
  font-size: 26rpx;
  color: #10213a;
  line-height: 1.7;
  white-space: pre-wrap;
}

.proficiency-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #eff6ff;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 14rpx;
  margin-bottom: 18rpx;
}

.star {
  font-size: 40rpx;
  color: #cbd5e1;
}

.star.active {
  color: #f59e0b;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #fff;
}

.login-tip {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 24rpx;
}
