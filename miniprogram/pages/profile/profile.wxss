.profile-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(14, 165, 233, 0.18), transparent 32%),
    radial-gradient(circle at top right, rgba(251, 191, 36, 0.16), transparent 28%),
    linear-gradient(180deg, #f8fbff 0%, #eef4ff 48%, #f8fafc 100%);
}

.hero-card,
.tool-section,
.account-panel {
  margin: 28rpx 24rpx 0;
}

.account-panel {
  margin-bottom: 36rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 34rpx 30rpx 30rpx;
  background: linear-gradient(140deg, #0f172a 0%, #1d4ed8 52%, #38bdf8 100%);
  box-shadow: 0 24rpx 56rpx rgba(37, 99, 235, 0.2);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
  opacity: 0.7;
}

.hero-glow-one {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-glow-two {
  width: 180rpx;
  height: 180rpx;
  left: -60rpx;
  bottom: -80rpx;
  background: rgba(125, 211, 252, 0.22);
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 1;
}

.hero-eyebrow,
.hero-title,
.badge-label,
.badge-value,
.badge-sub {
  display: block;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.hero-title {
  margin-top: 14rpx;
  width: 420rpx;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 700;
  color: #ffffff;
}

.avatar-shell {
  width: 108rpx;
  height: 108rpx;
  padding: 8rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10rpx);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}

.hero-badges {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-badge {
  padding: 22rpx 22rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12rpx);
}

.hero-badge.primary {
  background: rgba(255, 255, 255, 0.13);
}

.hero-badge.secondary {
  background: rgba(15, 23, 42, 0.18);
}

.badge-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.badge-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.badge-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tool-section,
.account-panel {
  border-radius: 32rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(148, 163, 184, 0.14);
  backdrop-filter: blur(10rpx);
}

.tool-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.section-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #94a3b8;
}

.section-title {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.tool-title,
.tool-desc,
.tool-title,
.account-desc {
  display: block;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.tool-card {
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.accent-blue {
  background: linear-gradient(140deg, #e0f2fe 0%, #dbeafe 100%);
}

.accent-orange {
  background: linear-gradient(140deg, #fff7ed 0%, #ffedd5 100%);
}

.accent-emerald {
  background: linear-gradient(140deg, #ecfdf5 0%, #d1fae5 100%);
}

.accent-sky {
  background: linear-gradient(140deg, #f0f9ff 0%, #e0f2fe 100%);
}

.tool-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.tool-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #475569;
}

.account-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.account-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
}

.account-btn.login {
  background: linear-gradient(135deg, #1d4ed8, #38bdf8);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.2);
}

.account-btn.logout {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  color: #b91c1c;
}
