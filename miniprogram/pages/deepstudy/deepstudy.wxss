/* 容器居中 */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 语法卡片 */
.card {
  width: 90%;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  padding: 40rpx;
  animation: fadeIn 0.6s ease-out;
}

/* 标题 */
.grammar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 按钮组 */
.button-group {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}

.btn {
  flex: 1;
  font-size: 26rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  color: #fff;
  text-align: center;
}

.known-btn {
  background: linear-gradient(to right, #34d399, #10b981);
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
}

.unknown-btn {
  background: linear-gradient(to right, #f87171, #ef4444);
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.3);
}

/* 语法详细信息 */
.grammar-detail {
  margin-top: 20rpx;
  animation: slideIn 0.4s ease-out;
}

.detail-label {
  font-size: 28rpx;      /* 加大字体 */
  font-weight: 700;      /* 加粗 */
  color: #1f2937;         /* 更深色，提升对比度 */
  margin-bottom: 10rpx;
  display: block;
}


.next-btn {
  margin-top: 40rpx;
  width: 100%;
  background: #3b82f6;
  color: #fff;
  font-size: 26rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

/* 完成状态 */
.completed {
  text-align: center;
  margin-top: 100rpx;
  animation: fadeIn 0.5s ease-out;
}

.completed-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #10b981;
  margin-bottom: 20rpx;
}

.completed-subtext {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
}

.restart-btn {
  background: #6366f1;
  color: #fff;
  padding: 24rpx 60rpx;
  font-size: 26rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

/* 加载状态 */
.loading {
  font-size: 28rpx;
  color: #9ca3af;
  margin-top: 100rpx;
  animation: fadeIn 0.5s ease-out;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
/* 语法信息卡片块 */
.detail-box {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease-in-out;
}

.detail-box:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.detail-label {
  font-weight: bold;
  font-size: 26rpx;
  color: #111827;
  margin-bottom: 10rpx;
  display: block;
}

.detail-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
}
