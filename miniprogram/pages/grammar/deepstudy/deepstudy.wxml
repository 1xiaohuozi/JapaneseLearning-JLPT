<view class="page theme-{{currentTheme}}">
  <view class="topbar">
    <button class="ghost-btn" bindtap="goToOverview">语法主页</button>
    <button class="ghost-btn" bindtap="goToFavorites">收藏夹</button>
  </view>

  <view class="hero-card">
    <view class="hero-badge">今日目标</view>
    <view class="hero-title">{{currentCollectionLabel}} 语法 {{sessionTarget}} 条小练习</view>
    <text class="hero-subtitle">完成后可回学习台、再来一轮，或复习低熟练语法。</text>
    <scroll-view class="collection-strip" scroll-x enhanced show-scrollbar="false">
      <view class="collection-row">
        <view
          wx:for="{{collections}}"
          wx:key="key"
          class="collection-pill {{item.key === currentCollection ? 'active' : ''}}"
          bindtap="switchCollection"
          data-collection="{{item.key}}"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <view class="session-grid">
      <view class="session-card">
        <text class="session-value">{{completedCount}}/{{sessionTotal}}</text>
        <text class="session-label">本轮进度</text>
      </view>
      <view class="session-card">
        <text class="session-value">{{reviewRemaining}}</text>
        <text class="session-label">本轮复习</text>
      </view>
      <view class="session-card">
        <text class="session-value">{{newRemaining}}</text>
        <text class="session-label">本轮新学</text>
      </view>
    </view>
  </view>

  <view wx:if="{{currentGrammar}}" class="study-card">
    <view class="study-header">
      <view class="study-index">#{{currentGrammar.grammar_id}}</view>
      <image
        class="favorite-icon"
        src="{{isFavorite ? '../../../images/star2.png' : '../../../images/star1.png'}}"
        mode="aspectFit"
        bindtap="toggleFavorite"
      />
    </view>

    <text class="study-title">{{currentGrammar.title}}</text>

    <view class="stars">
      <image
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="star-icon"
        src="{{item <= currentProficiency ? '../../../images/star2.png' : '../../../images/star1.png'}}"
        mode="aspectFit"
      />
      <text class="star-text">{{currentProficiency}} / 5</text>
    </view>

    <view class="study-stage">
      <view class="answer-row {{showDetail ? 'answer-row-hidden' : ''}}">
        <button class="unknown-btn" bindtap="handleAnswer" data-known="false">不认识</button>
        <button class="known-btn" bindtap="handleAnswer" data-known="true">认识</button>
      </view>
      <view wx:if="{{showDetail}}" class="answer-hint">
        <text>详情已展开，底部可直接进入下一条。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showDetail && currentGrammar}}" class="detail-overlay" catchtap="noop">
    <view class="detail-mask"></view>
    <view class="detail-sheet" catchtap="noop">
      <view class="detail-sheet-handle"></view>
      <view class="detail-sheet-head">
        <text class="detail-sheet-title">{{currentGrammar.title}}</text>
        <text class="detail-sheet-subtitle">#{{currentGrammar.grammar_id}} · {{currentCollectionLabel}}</text>
      </view>
      <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="false">
        <view class="detail-box" wx:if="{{currentGrammar.connection}}">
          <text class="detail-label">接续</text>
          <text class="detail-text">{{currentGrammar.connection}}</text>
        </view>
        <view class="detail-box">
          <text class="detail-label">意思</text>
          <text class="detail-text">{{currentGrammar.meaning}}</text>
        </view>
        <view class="detail-box" wx:if="{{currentGrammar.example}}">
          <text class="detail-label">例句</text>
          <text class="detail-text">{{currentGrammar.example}}</text>
        </view>
        <view class="detail-box" wx:if="{{currentGrammar.note}}">
          <text class="detail-label">备注</text>
          <text class="detail-text">{{currentGrammar.note}}</text>
        </view>
      </scroll-view>
      <view class="detail-footer">
        <button class="next-btn" bindtap="nextGrammar">下一条</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{allCompleted}}" class="complete-card">
    <text class="complete-title">本轮语法目标完成</text>
    <text class="complete-desc">今天先完成一个 {{sessionTarget}} 条小目标就够清楚了。如果状态还不错，可以再来一轮；如果已经没有待学内容，就切换等级或回到今日学习台。</text>
    <button class="next-btn" bindtap="loadGrammar">再来一轮</button>
    <button class="reset-btn" bindtap="resetStudy">重置本词书记录</button>
  </view>

  <view wx:else class="loading-card">
    <text>语法队列生成中...</text>
  </view>
</view>
