<view class="page theme-{{currentTheme}}">
  <view class="hero-card">
    <view class="hero-top">
      <view>
        <view class="hero-badge">语法学习</view>
        <view class="hero-title">从 {{currentCollectionLabel}} 到熟练掌握</view>
      </view>
      <view class="hero-actions">
        <button class="ghost-btn" bindtap="goToFavorites">收藏</button>
        <button class="primary-btn" bindtap="goToDeepStudy">深度学习</button>
      </view>
    </view>

    <scroll-view class="collection-strip" scroll-x enhanced show-scrollbar="false">
      <view class="collection-row">
        <view
          wx:for="{{collections}}"
          wx:key="key"
          class="collection-pill {{item.key === currentCollection ? 'active' : ''}}"
          bindtap="switchCollection"
          data-collection="{{item.key}}"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{stats.learned}}</text>
        <text class="stat-label">已学习</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.mastered}}</text>
        <text class="stat-label">已掌握</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.favorites}}</text>
        <text class="stat-label">已收藏</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{stats.total}}</text>
        <text class="stat-label">总语法</text>
      </view>
    </view>

    <view class="progress-panel">
      <view class="progress-line">
        <text class="progress-title">词书进度</text>
        <text class="progress-text">{{stats.learned}} / {{stats.total}} · {{stats.percent}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{stats.percent}}%;"></view>
      </view>
    </view>
  </view>

  <view class="toolbar">
    <view class="mode-toggle">
      <button class="mode-btn {{mode === 'order' ? 'active' : ''}}" bindtap="switchMode" data-mode="order">
        顺序
      </button>
      <button class="mode-btn {{mode === 'random' ? 'active' : ''}}" bindtap="switchMode" data-mode="random">
        随机
      </button>
    </view>
    <view class="meaning-switch">
      <text>显示释义</text>
      <switch checked="{{showMeaning}}" bindchange="toggleMeaning" color="#2563eb" />
    </view>
  </view>

  <view class="search-card">
    <input
      class="search-input"
      placeholder="搜索语法编号、标题、释义"
      bindinput="onSearchInput"
      value="{{searchText}}"
      confirm-type="search"
    />
    <button wx:if="{{searchText}}" class="clear-btn" bindtap="clearSearch">清空</button>
  </view>

  <view class="grammar-list" wx:if="{{grammarList.length}}">
    <view
      wx:for="{{grammarList}}"
      wx:key="grammar_id"
      class="grammar-card"
      bindtap="showDetail"
      data-id="{{item.grammar_id}}"
    >
      <view class="grammar-card-top">
        <view class="grammar-chip">#{{item.grammar_id}}</view>
        <view class="grammar-meta">
          <text class="grammar-title">{{item.title}}</text>
          <text class="grammar-sub" wx:if="{{userRecords[item.grammar_id]}}">熟练度 {{userRecords[item.grammar_id].proficiency || 0}} / 5</text>
          <text class="grammar-sub" wx:elif="{{favoriteMap[item.grammar_id]}}">已收藏</text>
        </view>
      </view>
      <view class="grammar-meaning" wx:if="{{showMeaning}}">{{item.meaning}}</view>
      <view class="grammar-note" wx:if="{{item.connection}}">接续：{{item.connection}}</view>
    </view>
  </view>

  <view class="empty-card" wx:elif="{{!loading}}">
    <text class="empty-title">当前没有找到语法</text>
    <text class="empty-desc">可以切换词书，或者试试更短的搜索词。</text>
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <text>{{loadingText || '加载中...'}}</text>
  </view>

  <view class="load-more" wx:if="{{hasMore && mode === 'order' && !loading}}">
    <button class="load-btn" bindtap="loadMore">加载更多</button>
  </view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideDetail">
    <view class="modal-card" catchtap="noop">
      <view class="modal-header">
        <view>
          <text class="modal-index">#{{currentGrammar.grammar_id}}</text>
          <text class="modal-title">{{currentGrammar.title}}</text>
        </view>
        <view class="modal-tools">
          <image
            class="favorite-icon"
            src="{{isFavorite ? '../../images/star2.png' : '../../images/star1.png'}}"
            mode="aspectFit"
            bindtap="toggleFavorite"
          />
          <button class="close-btn" bindtap="hideDetail">关闭</button>
        </view>
      </view>

      <view class="detail-section" wx:if="{{currentGrammar.connection}}">
        <text class="detail-label">接续</text>
        <text class="detail-text">{{currentGrammar.connection}}</text>
      </view>
      <view class="detail-section">
        <text class="detail-label">意思</text>
        <text class="detail-text">{{currentGrammar.meaning}}</text>
      </view>
      <view class="detail-section" wx:if="{{currentGrammar.example}}">
        <text class="detail-label">例句</text>
        <text class="detail-text">{{currentGrammar.example}}</text>
      </view>
      <view class="detail-section" wx:if="{{currentGrammar.note}}">
        <text class="detail-label">备注</text>
        <text class="detail-text">{{currentGrammar.note}}</text>
      </view>

      <view class="proficiency-panel" wx:if="{{isLoggedIn}}">
        <text class="detail-label">熟练度</text>
        <view class="stars">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:key="*this"
            class="star {{currentProficiency >= item ? 'active' : ''}}"
            bindtap="setProficiency"
            data-value="{{item}}"
          >
            ★
          </text>
        </view>
        <button class="save-btn" bindtap="updateProficiency">保存熟练度</button>
      </view>
      <view class="login-tip" wx:else>登录后可以保存熟练度和收藏。</view>
    </view>
  </view>
</view>
