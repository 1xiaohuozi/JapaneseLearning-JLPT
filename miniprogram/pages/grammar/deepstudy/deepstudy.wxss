.page {
  min-height: 100vh;
  padding: 28rpx;
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #eff5ff 0%, #f8fbff 60%, #ffffff 100%);
}

.theme-summit {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #eff5ff 0%, #eef2ff 50%, #ffffff 100%);
}

.theme-ocean {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #eaf7ff 0%, #eef6ff 50%, #ffffff 100%);
}

.theme-forest {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #edf9f4 0%, #f4fbf7 50%, #ffffff 100%);
}

.theme-sunrise {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 32%),
    linear-gradient(180deg, #fff3ea 0%, #fff8f1 50%, #ffffff 100%);
}

.topbar,
.hero-card,
.study-card,
.complete-card,
.loading-card,
.detail-sheet {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.08);
}

.topbar {
  border-radius: 24rpx;
  padding: 14rpx;
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.ghost-btn,
.known-btn,
.unknown-btn,
.next-btn,
.reset-btn {
  border: none;
  border-radius: 22rpx;
  font-size: 24rpx;
}

.ghost-btn {
  flex: 1;
  background: #eff6ff;
  color: #1d4ed8;
}

.hero-card {
  border-radius: 30rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #10213a;
}

.collection-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}

.collection-row {
  display: inline-flex;
  gap: 14rpx;
}

.collection-pill {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}

.collection-pill.active {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.session-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.session-card {
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  text-align: center;
}

.session-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.session-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.study-card,
.complete-card,
.loading-card {
  border-radius: 32rpx;
  padding: 28rpx;
}

.study-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.study-index {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0ecff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.favorite-icon {
  width: 48rpx;
  height: 48rpx;
}

.study-title {
  display: block;
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #10213a;
  line-height: 1.35;
}

.stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
}

.star-icon {
  width: 40rpx;
  height: 40rpx;
}

.star-text {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.study-stage {
  margin-top: 28rpx;
}

.answer-row {
  display: flex;
  gap: 14rpx;
  transition: opacity 180ms ease, transform 220ms ease;
}

.answer-row-hidden {
  opacity: 0.16;
  transform: scale(0.98);
  pointer-events: none;
}

.unknown-btn,
.known-btn {
  flex: 1;
  color: #fff;
}

.unknown-btn {
  background: linear-gradient(135deg, #ef4444, #dc2626);
}

.known-btn {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.answer-hint {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #1e40af;
  font-size: 22rpx;
  line-height: 1.6;
}

.detail-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.detail-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.18);
  backdrop-filter: blur(10rpx);
}

.detail-sheet {
  position: relative;
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  animation: detail-sheet-rise 220ms ease;
}

.detail-sheet-handle {
  width: 88rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
  margin: 0 auto 18rpx;
}

.detail-sheet-head {
  text-align: center;
}

.detail-sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #10213a;
}

.detail-sheet-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.detail-scroll {
  max-height: 56vh;
  margin-top: 20rpx;
  padding-bottom: 8rpx;
}

.detail-box {
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.detail-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.detail-text {
  font-size: 26rpx;
  color: #10213a;
  line-height: 1.7;
  white-space: pre-wrap;
}

.detail-footer {
  padding-top: 18rpx;
}

.next-btn,
.reset-btn {
  width: 100%;
  color: #fff;
}

.next-btn {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
}

.reset-btn {
  margin-top: 22rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
}

.complete-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.complete-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
  text-align: center;
}

.loading-card {
  text-align: center;
  font-size: 26rpx;
  color: #475569;
}

@keyframes detail-sheet-rise {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
