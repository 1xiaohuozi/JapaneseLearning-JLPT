<scroll-view class="score-page" scroll-y enable-flex>
  <view class="hero-card">
    <text class="hero-kicker">JLPT 模拟估分</text>
    <text class="hero-title">{{levelConfig.title}} 估分器</text>
    <text class="hero-desc">按分项正确率折算为官方分值区间，用于模拟合格线判断，不等同于官方最终出分。</text>

    <view class="hero-badges">
      <view class="hero-badge">
        <text class="badge-label">总分线</text>
        <text class="badge-value">{{levelConfig.overallPass}} / {{levelConfig.totalScore}}</text>
      </view>
      <view class="hero-badge">
        <text class="badge-label">分项门槛</text>
        <text class="badge-value">{{currentLevel === 'N4' || currentLevel === 'N5' ? '38 / 19' : '19 / 19 / 19'}}</text>
      </view>
    </view>
  </view>

  <view class="level-tabs">
    <block wx:for="{{levelTabs}}" wx:key="*this">
      <view class="level-chip {{item === currentLevel ? 'active' : ''}}" data-level="{{item}}" bindtap="switchLevel">{{item}}</view>
    </block>
  </view>

  <view class="action-row">
    <button class="ghost-btn" bindtap="showHistory">历史记录</button>
  </view>

  <view class="section-list">
    <block wx:for="{{levelConfig.sections}}" wx:key="key" wx:for-index="index">
      <view class="section-card">
        <view class="section-head">
          <view>
            <text class="section-title">{{item.title}}</text>
            <text class="section-subtitle">{{item.subtitle}}</text>
          </view>
          <view class="score-badge">{{item.scoreMax}} 分</view>
        </view>

        <view class="input-grid">
          <view class="input-card">
            <text class="input-label">总题数</text>
            <input
              type="number"
              class="score-input"
              placeholder="{{item.placeholder}}"
              value="{{sectionInputs[index].total}}"
              data-index="{{index}}"
              bindinput="onInputTotal"
            />
          </view>

          <view class="input-card">
            <text class="input-label">做对题数</text>
            <input
              type="number"
              class="score-input"
              placeholder="例如 20"
              value="{{sectionInputs[index].correct}}"
              data-index="{{index}}"
              bindinput="onInputCorrect"
            />
          </view>
        </view>

        <text class="section-hint">合格门槛：{{item.passMark}} 分</text>
      </view>
    </block>
  </view>

  <button class="calc-btn" bindtap="calcScore">立即估分</button>

  <view class="popup" hidden="{{!showPopup}}">
    <view class="popup-content result-popup">
      <view class="result-header">
        <text class="result-kicker">估分结果</text>
        <text class="result-title">{{result.level}} 模拟成绩单</text>
        <text class="result-date">{{result.date}}</text>
      </view>

      <view class="final-score-card {{result.pass ? 'pass' : 'fail'}}">
        <text class="final-score-label">估算总分</text>
        <text class="final-score-value">{{result.total}} / {{result.totalScore}}</text>
        <text class="final-score-status">{{result.pass ? '预计合格' : '预计未达线'}}</text>
      </view>

      <view class="result-section-list">
        <block wx:for="{{result.sectionScores}}" wx:key="key">
          <view class="result-section-card">
            <view class="result-section-head">
              <text class="result-section-title">{{item.title}}</text>
              <text class="result-grade">{{item.grade}}</text>
            </view>
            <view class="result-row">
              <text>估算分数</text>
              <text>{{item.score}} / {{item.scoreMax}}</text>
            </view>
            <view class="result-row">
              <text>原始作答</text>
              <text>{{item.correct}} / {{item.total}}</text>
            </view>
            <view class="result-row">
              <text>门槛</text>
              <text class="{{item.pass ? 'pass-text' : 'fail-text'}}">{{item.passMark}} 分 {{item.pass ? '达标' : '未达标'}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="result-note">
        <text>说明：JLPT 官方采用 scaled score，本站按分项正确率折算为估算分，仅用于模拟判断。</text>
      </view>

      <button class="close-btn" bindtap="closePopup">关闭</button>
    </view>
  </view>

  <view class="popup" hidden="{{!showHistoryPopup}}">
    <view class="popup-content history-popup">
      <view class="popup-header-row">
        <text class="history-title">历史估分</text>
        <text class="history-close" bindtap="closeHistoryPopup">×</text>
      </view>

      <view class="history-list" wx:if="{{historyList.length}}">
        <block wx:for="{{historyList}}" wx:key="_id">
          <view class="history-card" bindtap="selectHistory" data-item="{{item}}">
            <view class="history-top">
              <text class="history-level">{{item.level}}</text>
              <text class="history-date">{{item.date}}</text>
            </view>
            <view class="history-middle">
              <text class="history-total">{{item.total}} / {{item.totalScore}}</text>
              <text class="history-status {{item.pass ? 'pass-text' : 'fail-text'}}">{{item.pass ? '预计合格' : '预计未达线'}}</text>
            </view>
          </view>
        </block>
      </view>

      <view wx:else class="empty-history">还没有历史记录</view>

      <button class="close-btn" bindtap="closeHistoryPopup">关闭</button>
    </view>
  </view>
</scroll-view>
