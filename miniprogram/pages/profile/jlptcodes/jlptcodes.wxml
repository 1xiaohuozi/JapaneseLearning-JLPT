<view class="container"> 
  <view class="title">JLPT N2 分数計算器</view>
  
  <!-- 历史记录按钮 -->
  <view class="history-section">
 

    <button class="history-btn" bindtap="showHistory">查看历史记录</button>
  </view>

  <!-- 输入区 -->
  <block wx:for="{{sections}}" wx:key="title" wx:for-index="sIndex">
    <view class="section card animated-fade-in">
      <view class="section-title">{{item.title}}</view>
      <block wx:for="{{item.questions}}" wx:key="index">
        <view class="question-card">
          <text class="q-label">問題{{item.index}}</text>
          <view class="q-inputs">
            <input type="number" class="q-input"
                   placeholder="{{item.placeholder}}"
                   data-sid="{{sIndex}}" data-qid="{{item.index}}"
                   bindinput="onInputTotal"/>
            <input type="number" class="q-input"
                   placeholder="正确数"
                   data-sid="{{sIndex}}" data-qid="{{item.index}}"
                   bindinput="onInputCorrect"/>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- 计算按钮 -->
  <button class="calc-btn" bindtap="calcScore">查看結果</button>

  <!-- 保存按钮 -->


  <!-- 结果弹窗 -->
  <view class="popup" hidden="{{!showPopup}}">
    <view class="popup-content animated-fade-in">
      <!-- 顶部印章 -->
      <view class="jlpt-stamp">
        <text>JLPT試験</text>
        <text>結果通知</text>
        <text>能力認定</text>
      </view>

      <!-- 标题 -->
      <view class="popup-header">結果通知書 (Test Result)</view>
      <!-- <button class="save-btn" bindtap="saveScore" wx:if="{{showSaveBtn}}">保存本次估分</button> -->
      <!-- 基本信息 -->
      <view class="info">
        <text>受験日：{{result.date}}</text>
        <text> || </text>
        <text>レベル: N2</text>
      </view>

      <!-- 分数表格 -->
      <view class="score-table card">
        <view class="row">
          <view class="col">
            <text>文字・語彙：</text>
            <text>{{result.vocabGrammar}} / 60</text>
          </view>
          <view class="col">
            <text>読解：</text>
            <text>{{result.reading}} / 60</text>
          </view>
        </view>
        <view class="row">
          <view class="col">
            <text>聴解：</text>
            <text>{{result.listening}} / 60</text>
          </view>
          <view class="col">
            <text>総合：</text>
            <text>{{result.total}} / 180</text>
          </view>
        </view>
      </view>

      <!-- 等级判定 -->
      <view class="grade-table card">
        <view class="row">
          <view class="col">
            <text>文字・語彙</text>
            <text>{{result.grade.vocab}}</text>
          </view>
          <view class="col">
            <text>文法</text>
            <text>{{result.grade.grammar}}</text>
          </view>
        </view>
        <view class="row">
          <view class="col">
            <text>読解</text>
            <text>{{result.grade.reading}}</text>
          </view>
          <view class="col">
            <text>聴解</text>
            <text>{{result.grade.listening}}</text>
          </view>
        </view>
      </view>

      <!-- 判定 -->
      <view class="result-final">
        <text>{{result.pass ? '✅ 合格 / Passed' : '❌ 不合格 / Not Pass'}}</text>
      </view>

      <!-- 关闭按钮 -->
      <button class="close-btn" bindtap="closePopup">关闭</button>
    </view>
  </view>

  <!-- 历史记录弹窗 -->
  <view class="popup" hidden="{{!showHistoryPopup}}">
    <view class="popup-content history-popup">
      <view class="close-icon" bindtap="closeHistoryPopup">×</view>
      <view class="popup-header">历史估分记录</view>
      
      <view class="history-list">
        <block wx:for="{{historyList}}" wx:key="_id">
          <view class="history-item card" bindtap="selectHistory" data-item="{{item}}">
            <view class="history-date">{{item.date}}</view>
            <view class="history-scores">
              <text>总分: {{item.total}}</text>
              <text>文字語彙: {{item.vocabGrammar}}</text>
              <text>読解: {{item.reading}}</text>
              <text>聴解: {{item.listening}}</text>
            </view>
            <view class="history-result {{item.pass ? 'pass' : 'fail'}}">
              {{item.pass ? '合格' : '不合格'}}
            </view>
          </view>
        </block>
      </view>

      <view wx:if="{{historyList.length === 0}}" class="no-history">
        暂无历史记录
      </view>

      <button class="close-btn" bindtap="closeHistoryPopup">关闭</button>
    </view>
  </view>
</view>