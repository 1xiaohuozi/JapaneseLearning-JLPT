.page {
  min-height: 100vh;
  padding: 28rpx;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fbff 55%, #ffffff 100%);
  color: #10213a;
}

.header-card,
.toolbar,
.meaning-row,
.card,
.empty-card,
.loading-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.08);
}

.header-card {
  border-radius: 30rpx;
  padding: 24rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.collection-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}

.collection-row {
  display: inline-flex;
  gap: 14rpx;
}

.collection-pill {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}

.collection-pill.active {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff;
}

.toolbar {
  margin-top: 18rpx;
  border-radius: 24rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.clear-btn,
.close-btn,
.remove-btn {
  border: none;
  border-radius: 18rpx;
}

.clear-btn {
  min-width: 108rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
}

.meaning-row {
  margin-top: 16rpx;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.card {
  border-radius: 26rpx;
  padding: 22rpx;
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.grammar-id {
  min-width: 84rpx;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  background: #e0ecff;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.grammar-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.grammar-meaning {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}

.empty-card,
.loading-card {
  margin-top: 18rpx;
  border-radius: 28rpx;
  padding: 34rpx 28rpx;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
}

.modal-card {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.modal-index {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.modal-title {
  display: block;
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.close-btn {
  padding: 14rpx 22rpx;
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
}

.detail-section {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fbff;
}

.detail-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.remove-btn {
  width: 100%;
  margin-top: 22rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #fff;
  font-size: 26rpx;
}
