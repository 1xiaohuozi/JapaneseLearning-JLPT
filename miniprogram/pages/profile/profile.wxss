.profile-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(14, 165, 233, 0.18), transparent 32%),
    radial-gradient(circle at top right, rgba(251, 191, 36, 0.16), transparent 28%),
    linear-gradient(180deg, #f8fbff 0%, #eef4ff 48%, #f8fafc 100%);
}

.hero-card,
.tool-section,
.account-panel,
.today-panel {
  margin: 28rpx 24rpx 0;
}

.today-panel {
  margin-top: 24rpx;
}

.account-panel {
  margin-bottom: 36rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 34rpx 30rpx 30rpx;
  background: linear-gradient(140deg, #0f172a 0%, #1d4ed8 52%, #38bdf8 100%);
  box-shadow: 0 24rpx 56rpx rgba(37, 99, 235, 0.2);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(10rpx);
  opacity: 0.7;
}

.hero-glow-one {
  width: 200rpx;
  height: 200rpx;
  right: -40rpx;
  top: -20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-glow-two {
  width: 180rpx;
  height: 180rpx;
  left: -60rpx;
  bottom: -80rpx;
  background: rgba(125, 211, 252, 0.22);
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 1;
}

.hero-eyebrow,
.hero-title,
.badge-label,
.badge-value,
.badge-sub {
  display: block;
}

.hero-eyebrow {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.hero-title {
  margin-top: 14rpx;
  width: 420rpx;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 700;
  color: #ffffff;
}

.avatar-shell {
  width: 108rpx;
  height: 108rpx;
  padding: 8rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10rpx);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
}

.hero-badges {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-badge {
  padding: 22rpx 22rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(12rpx);
}

.hero-badge.primary {
  background: rgba(255, 255, 255, 0.13);
}

.hero-badge.secondary {
  background: rgba(15, 23, 42, 0.18);
}

.badge-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.badge-value {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.badge-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tool-section,
.account-panel,
.today-panel {
  border-radius: 32rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(148, 163, 184, 0.14);
  backdrop-filter: blur(10rpx);
}

.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.streak-pill {
  width: 132rpx;
  min-height: 104rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #dbeafe 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.streak-number {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}

.streak-label {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
}

.today-progress {
  height: 14rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.today-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #22c55e, #2563eb);
}

.task-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-row {
  min-height: 104rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.task-row.done {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.task-row.done .task-check {
  background: #22c55e;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
}

.task-desc {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.task-action {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tool-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.section-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #94a3b8;
}

.section-title {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.plan-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.plan-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.12);
}

.plan-card-title,
.plan-card-desc,
.plan-card-action {
  display: block;
}

.plan-card-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 700;
}

.plan-card-desc {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.5;
}

.plan-card-action {
  margin-top: 12rpx;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.tool-title,
.tool-desc,
.tool-title,
.account-desc {
  display: block;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.tool-card {
  min-height: 180rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.accent-blue {
  background: linear-gradient(140deg, #e0f2fe 0%, #dbeafe 100%);
}

.accent-orange {
  background: linear-gradient(140deg, #fff7ed 0%, #ffedd5 100%);
}

.accent-emerald {
  background: linear-gradient(140deg, #ecfdf5 0%, #d1fae5 100%);
}

.accent-sky {
  background: linear-gradient(140deg, #f0f9ff 0%, #e0f2fe 100%);
}

.tool-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.tool-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #475569;
}

.account-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
}

.account-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
}

.account-btn.login {
  background: linear-gradient(135deg, #1d4ed8, #38bdf8);
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(37, 99, 235, 0.2);
}

.account-btn.logout {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  color: #b91c1c;
}

.plan-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
}

.plan-modal {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 -18rpx 50rpx rgba(15, 23, 42, 0.18);
}

.plan-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-modal-kicker,
.plan-modal-title,
.plan-block-title,
.time-label,
.time-desc,
.jlpt-title,
.jlpt-desc {
  display: block;
}

.plan-modal-kicker {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.plan-modal-title {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.28;
}

.plan-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #475569;
  font-size: 36rpx;
  padding: 0;
}

.plan-block {
  margin-top: 28rpx;
}

.plan-block-title {
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.option-chip {
  min-width: 118rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  color: #334155;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.option-chip.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.time-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.time-option {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.time-option.active {
  background: #eff6ff;
  border-color: #93c5fd;
}

.time-label {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
}

.time-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.jlpt-row {
  margin-top: 28rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.jlpt-options {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.jlpt-option {
  min-width: 72rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #475569;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.jlpt-option.active {
  background: #2563eb;
  color: #ffffff;
}

.jlpt-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 700;
}

.jlpt-desc {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.plan-save {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2563eb, #22c55e);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}
