<view class="container fade-in">

<!-- 搜索框 -->
<view class="search-bar slide-in">
  <input style="width: 599rpx; display: block; box-sizing: border-box; height: 74rpx" placeholder="🔍 搜索收藏语法点" bindinput="onSearchInput" value="{{searchText}}" />
  <button wx:if="{{searchText}}" bindtap="clearSearch" class="clear-btn">✕</button>
</view>
<!-- 显示/隐藏意思的开关 -->
<view style="margin: 20rpx 0;" class="fade-in">
  <switch checked="{{showMeaning}}" bindchange="toggleMeaning" />
  <text style="margin-left: 20rpx;">{{showMeaning ? '显示语法意思' : '隐藏语法意思（暗记模式）'}}</text>
</view>

<!-- 收藏语法列表 -->
<view class="grammar-list fade-in-delay">
  <block wx:for="{{favoritesList}}" wx:key="_id">
    <view class="grammar-item hover-effect" bindtap="showDetail" data-id="{{item.grammar_id}}">
      <view class="grammar-header">
        <text class="grammar-id">#{{item.grammar_id}}</text>
        <text class="grammar-title">{{item.title}}</text>
      </view>
      <view class="grammar-meaning" wx:if="{{showMeaning}}">{{item.meaning}}</view>

    </view>
  </block>
</view>

<!-- 加载更多 -->
<view class="load-more" wx:if="{{hasMore}}">
  <button bindtap="loadMore" loading="{{loading}}" class="load-btn">加载更多</button>
</view>

<!-- 语法详情弹窗 -->
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-content slide-up">
    <view class="modal-header">
      <text class="modal-title">📘 {{currentGrammar.grammar_id}} {{currentGrammar.title}}</text>
      <button class="close-btn" bindtap="hideDetail">×</button>
    </view>
    <view class="modal-body">
      <view class="grammar-section">
        <text class="section-title">接续:</text>
        <text class="section-content">{{currentGrammar.connection}}</text>
      </view>
      <view class="grammar-section">
        <text class="section-title">意思:</text>
        <text class="section-content">{{currentGrammar.meaning}}</text>
      </view>
      <view class="grammar-section">
        <text class="section-title">例文:</text>
        <text class="section-content">{{currentGrammar.example}}</text>
      </view>
      <view class="grammar-section" wx:if="{{currentGrammar.note}}">
        <text class="section-title">注意:</text>
        <text class="section-content">{{currentGrammar.note}}</text>
      </view>
      <view class="modal-footer">
  <button class="unfavorite-btn" bindtap="removeFavorite">取消收藏</button>
</view>

    </view>
  </view>
</view>

</view>
