<view class="container">
  <view class="tab-container">
  <view class="tab" bindtap="goToOverview">所有语法</view>
  <view class="tab" bindtap="goToFavorites">语法收藏</view>
</view>



  <view wx:if="{{currentGrammar}}" class="card fade-in">
    <!-- 语法标题 + 收藏按钮 -->
    <view class="grammar-header">
      <text class="grammar-title">{{currentGrammar.grammar_id}}：{{currentGrammar.title}}</text>
      <view class="favorite-wrapper" bindtap="toggleFavorite">
      
        <image class="favorite-icon scale-in" 
               src="{{isFavorite ? '../../../images/star2.png' : '../../../images/star1.png'}}" 
               mode="aspectFit" />
               <text>收藏</text>
      </view>
    </view>

    <!-- ⭐ 熟练度星级展示 -->
<!-- 熟练度星级展示 -->
<!-- ⭐ 熟练度星级展示 -->
<!-- ⭐ 熟练度星级展示 -->
<view class="familiarity-stars">
  <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
    <image 
      class="star-icon" 
      src="{{item <= currentProficiency ? '../../../images/star2.png' : '../../../images/star1.png'}}" 
      mode="widthFix" 
    />
  </block>
  <text class="proficiency-text">({{currentProficiency}}/5)</text>
</view>



    <!-- 认识 / 不认识按钮 -->
    <view class="button-group" wx:if="{{!showDetail}}">
      <button class="btn known-btn" bindtap="handleAnswer" data-known="true">认识</button>
      <button class="btn unknown-btn" bindtap="handleAnswer" data-known="false">不认识</button>
    </view>

    <!-- 展示详情 -->
    <view wx:if="{{showDetail}}" class="grammar-detail slide-in">
      <view class="detail-box">
        <text class="detail-label">接续：</text>
        <text class="detail-text">{{currentGrammar.connection}}</text>
      </view>
      <view class="detail-box">
        <text class="detail-label">意思：</text>
        <text class="detail-text">{{currentGrammar.meaning}}</text>
      </view>
      <view class="detail-box">
        <text class="detail-label">例句：</text>
        <text class="detail-text">{{currentGrammar.example}}</text>
      </view>
      <view class="detail-box">
        <text class="detail-label">备注：</text>
        <text class="detail-text">{{currentGrammar.note}}</text>
      </view>

      <button class="next-btn" bindtap="nextGrammar">下一条</button>
    </view>
  </view>

  <!-- 所有完成提示 -->
  <view wx:elif="{{allCompleted}}" class="completed fade-in">
    <text class="completed-text">🎉 恭喜你，所有语法均已熟练！</text>
    <text class="completed-subtext">你可以点击下面按钮，重新开始复习。</text>
    <button class="restart-btn" bindtap="resetStudy">重新开始复习</button>
  </view>

  <!-- 加载中提示 -->
  <view wx:else class="loading fade-in">
    <text>⏳ 正在加载中...</text>
  </view>
</view>
