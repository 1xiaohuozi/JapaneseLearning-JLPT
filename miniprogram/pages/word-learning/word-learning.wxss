/* ===== 页面整体容器与背景 ===== */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx 0;
  position: relative;
}

.bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #a8edea, #fed6e3);
  z-index: -1;
}

/* ===== 等级选择器 ===== */
.level-picker {
  margin: 0 auto;
  width: 50%;
  text-align: center;
}
.picker-box {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #e0e0e0;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}
.picker-box:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}
.picker-label { font-size: 28rpx; color: #666; margin-right: 10rpx; }
.picker-value { font-size: 32rpx; font-weight: 600; color: #333; }
.picker-icon { width: 28rpx; height: 28rpx; margin-left: 10rpx; opacity: 0.6; }

/* ===== 顶部 Tab 样式 ===== */
.tab-container {
  width: 90%;
  display: flex;
  justify-content: space-around;
  margin: 30rpx 0;
  background: rgba(255,255,255,0.5);
  border-radius: 50rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  color: #555;
  transition: all 0.3s;
}
.tab-item.active {
  color: #3b82f6;
  border-bottom: 6rpx solid #3b82f6;
}

/* ===== 进度条 ===== */
.progress-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}
.progress-bar {
  width: 80%;
  height: 20rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 20rpx;
  margin: 20rpx auto 40rpx auto;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #36d1dc, #5b86e5);
  transition: width 0.4s ease;
}

/* ===== 卡片翻转 ===== */
.card-wrapper {
  width: 80%;
  height: 520rpx;
  perspective: 1500rpx;
  margin-bottom: 40rpx;
  position: relative;
}
.card {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
  backface-visibility: hidden;
  position: absolute;
  top: 0; left: 0;
  transition: transform 0.9s cubic-bezier(0.68,-0.55,0.27,1.55);
}
.front { transform: rotateY(0deg); }
.back { transform: rotateY(180deg); }
.card-wrapper.flipped .front { transform: rotateY(-180deg); }
.card-wrapper.flipped .back { transform: rotateY(0deg); }

/* ===== 卡片内容（正面） ===== */
.card-front-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 20rpx;
}
.word { font-size: 80rpx; font-weight: bold; color: #222; }
.level { font-size: 32rpx; color: #666; }
.btn-audio {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg,#36d1dc,#5b86e5);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 15rpx rgba(0,0,0,0.15);
}
.btn-audio2 {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg,#36d1dc,#5b86e5);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 15rpx rgba(0,0,0,0.15);
}
/* ===== 卡片内容（背面优化版） ===== */
.card-scroll {
  width: 100%;
  height: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 单词头部 */
.word-header {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 20rpx;
}
.word-main {
  font-size: 48rpx;
  font-weight: bold;
  color: #222;
}
.word-kana {
  font-size: 32rpx;
  color: #666;
  margin-left: 12rpx;
}

/* 词性 + 声调 */
.word-meta {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.meta-tag {
  font-size: 26rpx;
  color: #555;
  background: rgba(59,130,246,0.1);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}

/* 释义 */
.meaning-block {
  background: rgba(255,255,255,0.9);
  border-left: 6rpx solid #3b82f6;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.meaning {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
}

/* 例句 */
.example-block {
  background: rgba(255,255,255,0.8);
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.example-jp {
  font-size: 30rpx;
  color: #444;
}
.example-zh {
  font-size: 28rpx;
  color: #888;
  margin-top: 10rpx;
}

/* ===== 收藏按钮悬浮 ===== */
.favorite-btn-wrapper {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
}
.btn-favorite {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg,#fcd34d,#fbbf24);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 15rpx rgba(0,0,0,0.15);
}

/* ===== 操作按钮 ===== */
.btn-group { 
  display: flex; 
  gap: 40rpx; 
  justify-content: center; 
}
.btn { 
  width: 240rpx;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  transition: all 0.3s ease-in-out;
}
.btn-wrong { background: linear-gradient(135deg,#f7797d,#FBD786); }
.btn-right { background: linear-gradient(135deg,#56ab2f,#a8e063); }
.btn-next { background: linear-gradient(135deg,#36d1dc,#5b86e5); width: 300rpx; }

/* ===== 列表样式（收藏/全部） ===== */
.list-item {
  width: 90%;
  margin: 0 auto 24rpx auto;
  background: rgba(255,255,255,0.7);
  padding: 24rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  color: #333;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
}
.list-meaning {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}
.loading, .no-more {
  width: 90%;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 20rpx 0;
  margin: 10rpx auto;
  background: rgba(255,255,255,0.5);
  border-radius: 20rpx;
}

/* ===== 搜索框 ===== */
.search-box {
  width: 90%;
  margin: 20rpx auto;
}
.search-box input {
  width: 100%;
  padding: 20rpx;
  border-radius: 40rpx;
  border: 2rpx solid #ddd;
  background: rgba(255,255,255,0.6);
  font-size: 28rpx;
}
/* 例句朗读按钮 */
.btn-audio-example {
  min-width: 100rpx;              /* 短小 */
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #7bf3fc, #6b7ca0);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.12);
  transition: transform .12s ease;
}

.btn-audio-example:active {
  transform: scale(0.95);
}

