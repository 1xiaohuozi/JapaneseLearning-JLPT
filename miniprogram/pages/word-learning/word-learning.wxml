<view class="container"> 
  <!-- 背景 -->
  <view class="bg"></view>

  <!-- 等级选择器 -->
  <view class="level-picker">
    <picker mode="selector" range="{{levels}}" value="{{levelIndex}}" bindchange="onLevelChange">
      <view class="picker-box">
        <text class="picker-label">当前等级：</text>
        <text class="picker-value">{{levels[levelIndex]}}</text>
        <image class="picker-icon" src="/images/arrow-down.png" mode="aspectFit" />
      </view>
    </picker>
  </view>

  <!-- 顶部 Tab -->
  <view class="tab-container">
    <view class="tab-item {{currentTab==='study'?'active':''}}" data-tab="study" bindtap="switchTab">学习</view>
    <view class="tab-item {{currentTab==='favorites'?'active':''}}" data-tab="favorites" bindtap="switchTab">收藏</view>
    <view class="tab-item {{currentTab==='all'?'active':''}}" data-tab="all" bindtap="switchTab">单词列表</view>
  </view>

  <!-- 学习卡片 -->
  <block wx:if="{{currentTab==='study'}}">
    <!-- 进度 -->
    <view class="progress-text">{{currentIndex + 1}} / {{totalWords}}</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{(currentIndex+1)/totalWords*100}} + '%'"></view>

    </view>

    <view class="card-wrapper {{answered ? 'flipped' : ''}}">
      <!-- 正面 -->
      <view class="card front">
        <view class="card-front-content">
          <text class="word">{{currentWord.word}}</text>
          <text class="level">级别: {{currentWord.level}}</text>
          <button wx:if="{{currentWord.sounds && currentWord.sounds.length>0}}" 
            class="btn-audio" data-src="{{currentWord.sounds[0].fileid}}" bindtap="playAudio">🔊</button>
        </view>
      </view>

   <!-- 背面 -->
<view class="card back">
  <scroll-view scroll-y="true" class="card-scroll">
    <!-- 收藏按钮悬浮 -->
    <view class="favorite-btn-wrapper">
      <button class="btn-favorite" bindtap="toggleFavorite">
        {{isFavorited ? "★" : "☆"}}
      </button>
    </view>

    <!-- 单词 + 假名 -->
    <view class="word-header">
      <text class="word-main">{{currentWord.word}}</text>
      <text class="word-kana">（{{currentWord.kana}}）</text>
    </view>
    <button wx:if="{{currentWord.sounds && currentWord.sounds.length>0}}" 
            class="btn-audio2" data-src="{{currentWord.sounds[0].fileid}}" bindtap="playAudio">🔊</button>
    <!-- 词性 + 声调 -->
    <view class="word-meta">
      <text class="meta-tag">{{currentWord.pos}}</text>
      <text class="meta-tag">声调: {{currentWord.accent}}</text>
    </view>

    <!-- 释义 -->
    <view class="meaning-block">
      <text class="meaning">{{currentWord.meaning}}</text>
    </view>

    <!-- 例句 -->
    <view class="example-block">
      <text class="example-jp">📖 {{currentWord.example_jp}}</text>
      <rich-text class="example-furi" nodes="{{currentWord.example_jp_furigana}}"></rich-text>
      <text class="example-zh">👉 {{currentWord.example_zh_cn}}</text>
      <button wx:if="{{currentWord.sounds && currentWord.sounds.length>1}}"  
        class="btn-audio-example" 
        data-src="{{currentWord.sounds[1].fileid}}" 
        bindtap="playAudio">
  🔊 <text class="btn-text">例句朗读</text>
</button>

    </view>
  </scroll-view>
</view>

    </view>

    <!-- 操作按钮 -->
    <view class="btn-group">
      <block wx:if="{{!answered}}">
        <button class="btn btn-right" bindtap="chooseKnown" disabled="{{btnDisabled}}">认识</button>
        <button class="btn btn-wrong" bindtap="chooseUnknown" disabled="{{btnDisabled}}">不认识</button>
      </block>
      <block wx:elif="{{answered}}">
        <button class="btn btn-next" bindtap="nextWord">下一个 ➡️</button>
      </block>
    </view>
  </block>

  <!-- 收藏 -->
  <block wx:elif="{{currentTab==='favorites'}}">
    <scroll-view scroll-y="true" style="height: 80vh;" bindscrolltolower="loadMoreFavorites">
      <view wx:for="{{favoriteWords}}" wx:key="_id" class="list-item" data-id="{{item._id}}" bindtap="viewWordDetail">
        <text>{{item.word}} ({{item.level}})</text>
      </view>
      <view class="loading" wx:if="{{loadingFavorites}}">⏳ 正在加载收藏...</view>
      <view class="no-more" wx:if="{{!hasMoreFavorites}}">没有更多了</view>
    </scroll-view>
  </block>

  <!-- 单词列表 -->
  <block wx:elif="{{currentTab==='all'}}">
    <view class="search-box">
      <input type="text"
             placeholder="🔍 搜索单词或假名..."
             value="{{searchQuery}}"
             bindinput="onSearchInput"/>
    </view>
    <scroll-view scroll-y="true" style="height: 75vh;" bindscrolltolower="loadMoreWords">
      <view wx:for="{{filteredWords}}" wx:key="_id"
            class="list-item"
            data-id="{{item._id}}"
            bindtap="viewWordDetail">
        <text>{{item.word}} 【{{item.kana}}】</text>
        <text class="list-meaning">{{item.meaning}}</text>
      </view>
      <view class="loading" wx:if="{{loadingWords}}">⏳ 正在加载单词...</view>
      <view class="no-more" wx:if="{{!hasMoreWords}}">没有更多了</view>
    </scroll-view>
  </block>
  <!-- 单词详情弹窗 -->
<view wx:if="{{showDetail}}" class="detail-modal">
  <view class="detail-box">
    <!-- 关闭按钮 -->
    <button class="detail-close" bindtap="closeDetail">✖</button>

    <!-- 单词 + 假名 -->
    <view class="detail-header">
      <text class="detail-word">{{detailWord.word}}</text>
      <text class="detail-kana">（{{detailWord.kana}}）</text>
      <button wx:if="{{detailWord.sounds && detailWord.sounds.length>0}}" 
              class="btn-audio" 
              data-src="{{detailWord.sounds[0].fileid}}" 
              bindtap="playAudio">🔊</button>
    </view>

    <!-- 词性 + 声调 -->
    <view class="detail-meta">
      <text class="meta">{{detailWord.pos}}</text>
      <text class="meta">声调: {{detailWord.accent}}</text>
    </view>

    <!-- 中文释义 -->
    <view class="detail-meaning">
      <text>{{detailWord.meaning}}</text>
    </view>

    <!-- 例句 -->
    <view class="detail-example">
      <text class="jp">📖 {{detailWord.example_jp}}</text>
      <text class="zh">👉 {{detailWord.example_zh_cn}}</text>

      <!-- 例句朗读按钮 -->
      <button wx:if="{{detailWord.sounds && detailWord.sounds.length>1}}"  
              class="btn-audio-example" 
              data-src="{{detailWord.sounds[1].fileid}}" 
              bindtap="playAudio">
        🔊 例句朗读
      </button>
    </view>
  </view>
</view>

</view>
